<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#140217"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Top Divider Line (1dp #2A1040) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A1040" />

    <!-- 6 Equal-Weight Tab Slots Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingTop="4dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/tab_home"
            style="@style/MotionPulseTabSlot">
            <FrameLayout
                android:id="@+id/icon_container_home"
                style="@style/MotionPulseTabIconContainer">
                <ImageView
                    android:id="@+id/icon_home"
                    style="@style/MotionPulseTabIcon"
                    android:src="@drawable/ic_home" />
            </FrameLayout>
            <TextView
                android:id="@+id/label_home"
                style="@style/MotionPulseTabLabel"
                android:text="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_mood"
            style="@style/MotionPulseTabSlot">
            <FrameLayout
                android:id="@+id/icon_container_mood"
                style="@style/MotionPulseTabIconContainer">
                <ImageView
                    android:id="@+id/icon_mood"
                    style="@style/MotionPulseTabIcon"
                    android:src="@drawable/ic_mood" />
            </FrameLayout>
            <TextView
                android:id="@+id/label_mood"
                style="@style/MotionPulseTabLabel"
                android:text="Mood" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_habits"
            style="@style/MotionPulseTabSlot">
            <FrameLayout
                android:id="@+id/icon_container_habits"
                style="@style/MotionPulseTabIconContainer">
                <ImageView
                    android:id="@+id/icon_habits"
                    style="@style/MotionPulseTabIcon"
                    android:src="@drawable/ic_habits" />
            </FrameLayout>
            <TextView
                android:id="@+id/label_habits"
                style="@style/MotionPulseTabLabel"
                android:text="Habits" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_community"
            style="@style/MotionPulseTabSlot">
            <FrameLayout
                android:id="@+id/icon_container_community"
                style="@style/MotionPulseTabIconContainer">
                <ImageView
                    android:id="@+id/icon_community"
                    style="@style/MotionPulseTabIcon"
                    android:src="@drawable/ic_community" />
            </FrameLayout>
            <TextView
                android:id="@+id/label_community"
                style="@style/MotionPulseTabLabel"
                android:text="Community" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_stats"
            style="@style/MotionPulseTabSlot">
            <FrameLayout
                android:id="@+id/icon_container_stats"
                style="@style/MotionPulseTabIconContainer">
                <ImageView
                    android:id="@+id/icon_stats"
                    style="@style/MotionPulseTabIcon"
                    android:src="@drawable/ic_stats" />
            </FrameLayout>
            <TextView
                android:id="@+id/label_stats"
                style="@style/MotionPulseTabLabel"
                android:text="Stats" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_profile"
            style="@style/MotionPulseTabSlot">
            <FrameLayout
                android:id="@+id/icon_container_profile"
                style="@style/MotionPulseTabIconContainer">
                <ImageView
                    android:id="@+id/icon_profile"
                    style="@style/MotionPulseTabIcon"
                    android:src="@drawable/ic_profile" />
            </FrameLayout>
            <TextView
                android:id="@+id/label_profile"
                style="@style/MotionPulseTabLabel"
                android:text="Profile" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
