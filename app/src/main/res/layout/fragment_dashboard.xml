<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Droplet Header -->
            <com.example.motionpulse.ui.views.DropletHeaderView
                android:id="@+id/droplet_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Sync / Offline Status Banner -->
            <TextView
                android:id="@+id/tv_offline_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#99CC0000"
                android:gravity="center"
                android:padding="8dp"
                android:text="Offline: Showing cached data"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_sync_error_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#99880000"
                android:gravity="center"
                android:padding="8dp"
                android:text="Cloud sync blocked. Local changes saved."
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />

            <!-- Progress Ring Row Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.motionpulse.ui.views.DashboardProgressRingView
                    android:id="@+id/progress_ring"
                    android:layout_width="96dp"
                    android:layout_height="96dp" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_progress_ratio"
                        style="@style/TextAppearance.MotionPulse.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textColor="@color/text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.MotionPulse.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="habits today"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />

            <!-- Mood Banner ("How's your rhythm today?") -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mood_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="56dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        style="@style/TextAppearance.MotionPulse.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="How's your rhythm today?"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.MotionPulse.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log mood →"
                        android:textColor="@color/accent_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="1dp"
                android:layout_height="10dp" />

            <!-- Motivation Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_motivation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.MotionPulse.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="MOTIVATION OF THE DAY"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_daily_quote"
                        style="@style/TextAppearance.MotionPulse.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Small steps lead to big results."
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's Habits Section Title (20sp bold, 16dp above, 8dp below) -->
            <TextView
                style="@style/TextAppearance.MotionPulse.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Today's habits"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- StateLayout Wrapping Habits List -->
            <com.example.motionpulse.ui.views.StateLayout
                android:id="@+id/state_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_habits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </com.example.motionpulse.ui.views.StateLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
