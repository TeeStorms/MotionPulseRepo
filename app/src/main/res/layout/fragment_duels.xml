<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="96dp">

            <!-- Challenge a Friend Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_challenge_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeColor="#B3E01E79"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.MotionPulse.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Habit Duels"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.MotionPulse.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Challenge a friend to a 7-day head-to-head consistency race!"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_challenge_banner"
                        style="@style/Widget.MotionPulse.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="Challenge a Friend" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="1dp"
                android:layout_height="24dp" />

            <!-- Group Challenges Section -->
            <TextView
                style="@style/TextAppearance.MotionPulse.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group Challenges"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeColor="#B3E01E79"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.MotionPulse.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Global Consistency Marathon"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.MotionPulse.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Day 5 of 14 • 9 participants"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="12dp" />

                    <!-- Stacked Avatars Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.example.motionpulse.ui.views.UserAvatarView
                            android:layout_width="28dp"
                            android:layout_height="28dp" />

                        <com.example.motionpulse.ui.views.UserAvatarView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="-10dp" />

                        <com.example.motionpulse.ui.views.UserAvatarView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="-10dp" />

                        <TextView
                            style="@style/TextAppearance.MotionPulse.Caption"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="-10dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center"
                            android:text="+6"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_group_progress_pct"
                            style="@style/TextAppearance.MotionPulse.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65%"
                            android:textColor="@color/accent_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="1dp"
                        android:layout_height="8dp" />

                    <!-- Progress Bar 8dp tall -->
                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="65"
                        android:progressBackgroundTint="#2C1236"
                        android:progressTint="@color/accent_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="1dp"
                android:layout_height="24dp" />

            <!-- Active & Completed Duels Header (20sp bold) -->
            <TextView
                style="@style/TextAppearance.MotionPulse.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Duels"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="12dp" />

            <!-- StateLayout Wrapping Duels List -->
            <com.example.motionpulse.ui.views.StateLayout
                android:id="@+id/state_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_duels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </com.example.motionpulse.ui.views.StateLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
