<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <com.example.motionpulse.ui.views.DropletHeaderView
            android:id="@+id/droplet_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_badge_count"
                style="@style/TextAppearance.MotionPulse.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 of 10 badges unlocked"
                android:textColor="@color/accent_primary"
                android:textSize="18sp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />

            <com.example.motionpulse.ui.views.StateLayout
                android:id="@+id/state_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_badges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </com.example.motionpulse.ui.views.StateLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
