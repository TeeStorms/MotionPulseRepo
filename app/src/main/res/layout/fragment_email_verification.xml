<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <com.example.motionpulse.ui.views.DropletHeaderView
            android:id="@+id/droplet_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="1dp"
            android:layout_height="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📩"
            android:textSize="64sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We sent a verification link to:"
            style="@style/TextAppearance.MotionPulse.Body"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="user@example.com"
            style="@style/TextAppearance.MotionPulse.Body"
            android:textStyle="bold"
            android:textColor="@color/accent_primary" />

        <Space
            android:layout_width="1dp"
            android:layout_height="32dp" />

        <TextView
            style="@style/TextAppearance.MotionPulse.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="24dp"
            android:text="Please click the link in the email to verify your account. If you don't see it, check your spam folder." />

        <Space
            android:layout_width="1dp"
            android:layout_height="32dp" />

        <Button
            android:id="@+id/btn_continue"
            style="@style/Widget.MotionPulse.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I've verified — Continue" />

        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <Button
            android:id="@+id/btn_resend"
            style="@style/Widget.MotionPulse.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resend Verification Email" />

        <Space
            android:layout_width="1dp"
            android:layout_height="24dp" />

        <Button
            android:id="@+id/btn_logout"
            style="@style/Widget.MotionPulse.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Login" />

    </LinearLayout>
</ScrollView>
