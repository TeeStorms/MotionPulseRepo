<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_leaderboard_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_rank"
            style="@style/TextAppearance.MotionPulse.TitleMedium"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/accent_primary"
            android:textSize="18sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <com.example.motionpulse.ui.views.UserAvatarView
            android:id="@+id/avatar_view"
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                style="@style/TextAppearance.MotionPulse.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Display Name"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_level"
                style="@style/TextAppearance.MotionPulse.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lvl 1"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_metric_value"
            style="@style/TextAppearance.MotionPulse.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="100 XP"
            android:textColor="@color/accent_blue"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_challenge_swords"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Challenge Friend"
            android:padding="8dp"
            android:src="@drawable/ic_group" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
