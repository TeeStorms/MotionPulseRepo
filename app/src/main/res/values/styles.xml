<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TextAppearances -->
    <style name="TextAppearance.MotionPulse.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.MotionPulse.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MotionPulse.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.MotionPulse.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.MotionPulse.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/primary_button_gradient</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.MotionPulse.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/card_border_alt</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.MotionPulse.Button.Destructive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/profile_logout_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- TextInputLayout / EditText -->
    <style name="Widget.MotionPulse.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/add_habit_input_bg</item>
        <item name="boxStrokeColor">@color/card_border_alt</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- Chip, Switch and Dialog Styles -->
    <style name="Widget.MotionPulse.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/card_background</item>
        <item name="chipStrokeColor">@color/card_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.MotionPulse.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/accent_primary</item>
        <item name="trackTint">@color/card_background</item>
    </style>

    <style name="Theme.MotionPulse.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>
</resources>
