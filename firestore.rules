rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAcceptedFriend(uid1, uid2) {
      return exists(/databases/$(database)/documents/friendRequests/$(uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1))
        && get(/databases/$(database)/documents/friendRequests/$(uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1)).data.status == 'ACCEPTED';
    }

    function isPendingFriendRequest(uid1, uid2) {
      return exists(/databases/$(database)/documents/friendRequests/$(uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1))
        && get(/databases/$(database)/documents/friendRequests/$(uid1 < uid2 ? uid1 + '_' + uid2 : uid2 + '_' + uid1)).data.status == 'PENDING';
    }

    // Private User Profile & Sub-collections (Owner only)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /blocks/{blockedId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /habits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /completions/{completionId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /moods/{moodId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /badges/{badgeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.data.keys().hasOnly(['language', 'remindersEnabled', 'shareMilestones', 'showHabitNames', 'updatedAt'])
                     && (request.resource.data.remindersEnabled is bool)
                     && (request.resource.data.shareMilestones is bool)
                     && (request.resource.data.showHabitNames is bool)
                     && (
                          !('language' in request.resource.data) ||
                          request.resource.data.language == null ||
                          (request.resource.data.language is string && request.resource.data.language in ['en', 'af', 'tn', 'zu', 'ts'])
                        )
                     && (request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is int || request.resource.data.updatedAt is number);
      }

      match /notifications/{notificationId} {
        // READ & DELETE: Owner only
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        // UPDATE: Owner only, and only isRead may change
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

        // CREATE: Owner OR cross-user notification write with relationship, block & schema checks
        allow create: if request.auth != null && (
          // Owner creating for themselves (except NUDGE)
          (request.auth.uid == userId && request.resource.data.type != 'NUDGE') ||
          // Cross-user creation
          (
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.type in ['NUDGE', 'FRIEND_REQUEST', 'FRIEND_ACCEPTED', 'DUEL_INVITE', 'DUEL_RESULT'] &&
            request.resource.data.keys().hasOnly(['id', 'senderId', 'senderName', 'type', 'timestamp', 'isRead', 'habitType', 'duelId', 'message']) &&
            request.resource.data.isRead == false &&
            !exists(/databases/$(database)/documents/users/$(userId)/blocks/$(request.auth.uid)) &&
            (
              !('message' in request.resource.data) ||
              request.resource.data.message == null ||
              (request.resource.data.message is string && request.resource.data.message.size() <= 140)
            ) &&
            (
              (request.resource.data.type in ['NUDGE', 'DUEL_INVITE', 'DUEL_RESULT', 'FRIEND_ACCEPTED'] && isAcceptedFriend(request.auth.uid, userId)) ||
              (request.resource.data.type == 'FRIEND_REQUEST' && isPendingFriendRequest(request.auth.uid, userId))
            ) &&
            (
              request.resource.data.type != 'NUDGE' ||
              (
                request.resource.data.senderId != userId &&
                notificationId.matches('^nudge_' + request.auth.uid + '_' + userId + '_.*')
              )
            )
          )
        );
      }
    }

    match /publicProfiles/{userId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 1;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 30))
                   && (!('friendCode' in request.resource.data) || (request.resource.data.friendCode is string && request.resource.data.friendCode.matches('^MP-[2-9A-HJKMNP-Z]{4}-[2-9A-HJKMNP-Z]{4}$')));
    }

    // Friend Requests
    match /friendRequests/{requestId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && ('participants' in resource.data) && (request.auth.uid in resource.data.participants);

      allow create: if request.auth != null
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    && ('participants' in request.resource.data)
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && (request.auth.uid in request.resource.data.participants)
                    && requestId == (request.resource.data.requesterUid < request.resource.data.recipientUid ? request.resource.data.requesterUid + '_' + request.resource.data.recipientUid : request.resource.data.recipientUid + '_' + request.resource.data.requesterUid)
                    && (!('respondedAt' in request.resource.data) || request.resource.data.respondedAt == null)
                    && request.resource.data.keys().hasOnly(['requesterUid', 'recipientUid', 'participants', 'status', 'createdAt', 'respondedAt'])
                    && !exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)/blocks/$(request.auth.uid));

      allow update: if request.auth != null
                    && resource.data.status == 'PENDING'
                    && resource.data.recipientUid == request.auth.uid
                    && (request.resource.data.status == 'ACCEPTED' || request.resource.data.status == 'DECLINED');

      allow delete: if request.auth != null && (
        (resource.data.status == 'PENDING' && resource.data.requesterUid == request.auth.uid) ||
        (resource.data.status == 'ACCEPTED' && ('participants' in resource.data) && (request.auth.uid in resource.data.participants))
      );
    }

    // Activity Feed (Friends-only audience model)
    match /activityFeed/{entryId} {
      // Owner can read any doc they created (needed for the "unfriend" cleanup query)
      allow get, list: if request.auth != null && (
        (('visibleTo' in resource.data) && (request.auth.uid in resource.data.visibleTo)) ||
        (('actorId' in resource.data) && (resource.data.actorId == request.auth.uid))
      );

      allow create: if request.auth != null
                    && request.resource.data.actorId == request.auth.uid
                    && ('visibleTo' in request.resource.data)
                    && (request.auth.uid in request.resource.data.visibleTo)
                    && (!('habitName' in request.resource.data) || (request.resource.data.habitName is string && request.resource.data.habitName.size() <= 60))
                    && !exists(/databases/$(database)/documents/activityFeed/$(entryId));

      allow update: if request.auth != null && (
        (
          ('visibleTo' in resource.data) &&
          (request.auth.uid in resource.data.visibleTo) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
        ) ||
        (
          resource.data.actorId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['habitName']) &&
          !('habitName' in request.resource.data)
        )
      );

      allow delete: if request.auth != null && ('actorId' in resource.data) && resource.data.actorId == request.auth.uid;
    }

    // Challenges
    match /challenges/{challengeId} {
      allow read: if request.auth != null && ('participantIds' in resource.data) && (request.auth.uid in resource.data.participantIds);

      allow create: if request.auth != null;

      allow update: if request.auth != null
                    && ('participantIds' in resource.data)
                    && (request.auth.uid in request.resource.data.participantIds || request.auth.uid in request.resource.data.participantIds)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'progress']);

      allow delete: if request.auth != null;
    }

    // Duels
    match /duels/{duelId} {
      allow read: if request.auth != null && ('participants' in resource.data) && (request.auth.uid in resource.data.participants);

      allow create: if request.auth != null
                    && ('participants' in request.resource.data)
                    && request.resource.data.participants.size() == 2
                    && (request.auth.uid in request.resource.data.participants)
                    && request.resource.data.status == 'ACTIVE'
                    && isAcceptedFriend(
                         request.auth.uid,
                         request.auth.uid == request.resource.data.participants[0] ? request.resource.data.participants[1] : request.resource.data.participants[0]
                       );

      allow update: if request.auth != null
                    && ('participants' in resource.data)
                    && (request.auth.uid in resource.data.participants)
                    && (!('participants' in request.resource.data) || request.resource.data.participants == resource.data.participants)
                    && (
                      // 1) Score increment or decrement while ACTIVE and before endDate, +/-1 by caller
                      (
                        resource.data.status == 'ACTIVE' &&
                        (!('status' in request.resource.data) || request.resource.data.status == 'ACTIVE') &&
                        request.time < timestamp.date(int(resource.data.endDate.split('-')[0]), int(resource.data.endDate.split('-')[1]), int(resource.data.endDate.split('-')[2])) + duration.value(1, 'd') &&
                        (!('winnerId' in request.resource.data) || request.resource.data.winnerId == resource.data.winnerId) &&
                        request.auth.uid in resource.data.scores &&
                        ('scores' in request.resource.data) &&
                        request.auth.uid in request.resource.data.scores &&
                        request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([request.auth.uid]) &&
                        (
                          request.resource.data.scores[request.auth.uid] == resource.data.scores[request.auth.uid] + 1 ||
                          request.resource.data.scores[request.auth.uid] == resource.data.scores[request.auth.uid] - 1
                        ) &&
                        request.resource.data.scores[request.auth.uid] >= 0
                      ) ||
                      // 2) Transition ACTIVE to COMPLETED after endDate with correct winnerId matching scores or DRAW
                      (
                        resource.data.status == 'ACTIVE' &&
                        ('status' in request.resource.data && request.resource.data.status == 'COMPLETED') &&
                        request.time >= timestamp.date(int(resource.data.endDate.split('-')[0]), int(resource.data.endDate.split('-')[1]), int(resource.data.endDate.split('-')[2])) + duration.value(1, 'd') &&
                        (!('scores' in request.resource.data) || request.resource.data.scores == resource.data.scores) &&
                        resource.data.participants.size() == 2 &&
                        resource.data.participants[0] in resource.data.scores &&
                        resource.data.participants[1] in resource.data.scores &&
                        ('winnerId' in request.resource.data) &&
                        (
                          (resource.data.scores[resource.data.participants[0]] > resource.data.scores[resource.data.participants[1]] && request.resource.data.winnerId == resource.data.participants[0]) ||
                          (resource.data.scores[resource.data.participants[1]] > resource.data.scores[resource.data.participants[0]] && request.resource.data.winnerId == resource.data.participants[1]) ||
                          (resource.data.scores[resource.data.participants[0]] == resource.data.scores[resource.data.participants[1]] && request.resource.data.winnerId == 'DRAW')
                        )
                      ) ||
                      // 3) Transition ACTIVE to CANCELLED (e.g. unfriend)
                      (
                        resource.data.status == 'ACTIVE' &&
                        ('status' in request.resource.data && request.resource.data.status == 'CANCELLED')
                      )
                    );

      allow delete: if request.auth != null && ('participants' in resource.data) && (request.auth.uid in resource.data.participants);
    }

    // Friend Codes Mapping Documents (Lookups)
    match /friendCodes/{code} {
      // single document get for any signed-in user; listing is never allowed
      allow get: if request.auth != null;
      allow list: if false;

      // a user may create the mapping only for THEIR OWN code, and only if it does not exist yet
      // (create on an existing document counts as an update, which is denied, so nobody can overwrite)
      allow create: if request.auth != null
        && code.matches('^MP-[2-9A-HJKMNP-Z]{4}-[2-9A-HJKMNP-Z]{4}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.friendCode == code;

      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Default-deny fallback rule for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
